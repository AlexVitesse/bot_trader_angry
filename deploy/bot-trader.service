# Unidad systemd de USUARIO para el bot (plantilla; setup_server.sh la instala
# sustituyendo @BOT_DIR@ y @PYTHON@).
#
# Codigos de salida del bot:
#   0  = parada limpia (Ctrl+C, kill switch) -> NO se relanza
#   1  = watchdog de red (3 velas sin red)   -> se relanza
#   43 = /restart, /update                   -> se relanza
# Restart=on-failure hace exactamente eso. OJO: `kill <pid>` (SIGTERM) cuenta
# como parada limpia para systemd y NO relanza: reiniciar con
#   systemctl --user restart bot-trader
[Unit]
Description=Bot de trading V2 (BTC/USDT, Binance Futures 4h)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@BOT_DIR@
ExecStart=@PYTHON@ -u -m src.ml_bot
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
